{
    "name": "clarion-app/life-log-backend",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "ClarionApp\\LifeLogBackend\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Tim Schwartz",
            "email": "tim@metaverse.systems"
        }
    ],
    "minimum-stability": "dev",
    "require": {
        "ext-bcmath": "*",
        "clarion-app/contacts-backend": "dev-main",
        "clarion-app/eloquent-multichain-bridge": "dev-main",
        "clarion-app/backend": "dev-main",
        "guzzlehttp/guzzle": "^7"
    },
    "require-dev": {
        "orchestra/testbench": "^9",
        "phpunit/phpunit": "^11"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "ClarionApp\\LifeLogBackend\\LifeLogBackendServiceProvider"
            ]
        },
        "clarion": {
            "app-name": "@clarion-app/life-log",
            "description": "Provides operations for managing life log data"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
